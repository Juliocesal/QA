# SAP Logon connection description as shown in the SAP Logon list.
SAP_CONNECTION_NAME=
SAP_CLIENT=
SAP_USER=
SAP_PASSWORD=
SAP_LANGUAGE=EN
# Optional full path if saplogon.exe is not available through Windows.
SAPLOGON_PATH=

# Separate password required to delete a saved audit from the history.
AUDIT_DELETE_PASSWORD=
